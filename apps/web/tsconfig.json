{
  // kit 3：生成配置改从 `$app/tsconfig`（node_modules/$app/tsconfig.json，由
  // svelte-kit sync 写出）继承，且要求自带 include/exclude；不再生成
  // .svelte-kit/tsconfig.json。
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "lib": ["esnext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    // kit 生成的父配置将 types 收窄为 ['$app/types']；此处补回 @types/node，
    // 否则 include 进来的 vite.config.ts 等根文件解析不了 node 内建模块；
    // vite/client 提供 ?raw/?inline 资产导入模块声明（md-export Task 2b katexExportCss）
    "types": ["node", "$app/types", "vite/client"]
  },
  // render-text 留守的 vendor ambient 声明（katex-dist-css：pipeline 动态 import
  // 'katex/dist/katex.min.css' 无类型）；markdown-it 五插件垫片已随引擎迁
  // @vviewer/markdown-engine（经其 engine.ts 的 /// reference 随解析自动进程序）
  "include": ["src", "test", "*", "../../packages/render-text/src/types"],
  "exclude": ["src/service-worker"]
}
