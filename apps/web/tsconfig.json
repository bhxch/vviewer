{
  // kit 3：生成配置改从 `$app/tsconfig`（node_modules/$app/tsconfig.json，由
  // svelte-kit sync 写出）继承，且要求自带 include/exclude；不再生成
  // .svelte-kit/tsconfig.json。
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "lib": ["esnext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    // kit 生成的父配置将 types 收窄为 ['$app/types']；此处补回 @types/node，
    // 否则 include 进来的 vite.config.ts 等根文件解析不了 node 内建模块
    "types": ["node", "$app/types"]
  },
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
