{
  "name": "@bhxch/vviewer-vscode",
  "version": "0.1.0",
  "displayName": "VViewer",
  "description": "在 VSCode 内以 webview 只读渲染 markdown / 代码 / 图片 / 音视频 / PDF / HTML / JSONL / hex",
  "publisher": "bhxch",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/bhxch/vviewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhxch/vviewer.git"
  },
  "bugs": {
    "url": "https://github.com/bhxch/vviewer/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "preview",
    "viewer",
    "pdf",
    "hex"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vviewer.viewer",
        "displayName": "VViewer",
        "priority": "default",
        "selector": []
      }
    ],
    "commands": [
      {
        "command": "vviewer.openWithNative",
        "title": "Open with Native Editor",
        "category": "VViewer"
      },
      {
        "command": "vviewer.reload",
        "title": "Reload",
        "category": "VViewer"
      },
      {
        "command": "vviewer.exportHtml",
        "title": "Export as HTML",
        "category": "VViewer"
      }
    ],
    "configuration": {
      "title": "VViewer",
      "properties": {
        "vviewer.toc.side": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "scope": "window",
          "description": "Side the outline panel is docked to (left / right)."
        },
        "vviewer.toc.defaultCollapsed": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Collapse the outline panel by default."
        },
        "vviewer.code.highlightEngine": {
          "type": "string",
          "enum": [
            "tree-sitter",
            "hljs",
            "plain"
          ],
          "default": "tree-sitter",
          "scope": "language-overridable",
          "description": "Highlight engine for code files (tree-sitter / hljs / plain). Can be overridden per language, e.g. \"[python]\"."
        },
        "vviewer.markdown.diagramMode": {
          "type": "string",
          "enum": [
            "local",
            "kroki",
            "off"
          ],
          "default": "local",
          "scope": "language-overridable",
          "description": "Diagram rendering mode (local / kroki / off). Can be overridden per language, e.g. \"[markdown]\"."
        },
        "vviewer.diagrams.allowRemoteServices": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Allow remote diagram services (kroki / PlantUML). Off by default: the extension makes no external requests."
        },
        "vviewer.markdown.externalImages": {
          "type": "string",
          "enum": [
            "blocked",
            "manual",
            "auto"
          ],
          "default": "blocked",
          "scope": "window",
          "description": "Policy for images loaded from external hosts (blocked / manual / auto)."
        },
        "vviewer.markdown.externalImageAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "Host allowlist for external images (used when the policy is \"manual\")."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "ovsx": "^1.4.0"
  },
  "dependencies": {
    "@bhxch/vviewer-core": "workspace:*",
    "@bhxch/vviewer-detect": "workspace:*",
    "@bhxch/vviewer-highlight": "workspace:*",
    "@bhxch/vviewer-lightbox": "workspace:*",
    "@bhxch/vviewer-markdown": "workspace:*",
    "@bhxch/vviewer-render-binary": "workspace:*",
    "@bhxch/vviewer-render-diagram": "workspace:*",
    "@bhxch/vviewer-render-doc": "workspace:*",
    "@bhxch/vviewer-render-media": "workspace:*",
    "@bhxch/vviewer-render-text": "workspace:*",
    "@bhxch/vviewer-sanitize": "workspace:*",
    "katex": "^0.19.0"
  }
}
