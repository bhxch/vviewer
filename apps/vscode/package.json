{
  "name": "@bhxch/vviewer-vscode",
  "version": "0.1.0",
  "displayName": "VViewer",
  "description": "在 VSCode 内以 webview 只读渲染 markdown / 代码 / 图片 / 音视频 / PDF / HTML / JSONL / hex",
  "publisher": "bhxch",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/bhxch/vviewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhxch/vviewer.git"
  },
  "bugs": {
    "url": "https://github.com/bhxch/vviewer/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "preview",
    "viewer",
    "pdf",
    "hex"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vviewer.viewer",
        "displayName": "VViewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "vviewer.openWithNative",
        "title": "%command.vviewer.openWithNative.title%",
        "category": "VViewer"
      },
      {
        "command": "vviewer.reload",
        "title": "%command.vviewer.reload.title%",
        "category": "VViewer"
      },
      {
        "command": "vviewer.exportHtml",
        "title": "%command.vviewer.exportHtml.title%",
        "category": "VViewer"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "vviewer.toc.side": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "scope": "window",
          "description": "%configuration.vviewer.toc.side.description%",
          "title": "%configuration.vviewer.toc.side.title%"
        },
        "vviewer.toc.defaultCollapsed": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%configuration.vviewer.toc.defaultCollapsed.description%",
          "title": "%configuration.vviewer.toc.defaultCollapsed.title%"
        },
        "vviewer.code.highlightEngine": {
          "type": "string",
          "enum": [
            "tree-sitter",
            "hljs",
            "plain"
          ],
          "default": "tree-sitter",
          "scope": "language-overridable",
          "description": "%configuration.vviewer.code.highlightEngine.description%",
          "title": "%configuration.vviewer.code.highlightEngine.title%"
        },
        "vviewer.markdown.diagramMode": {
          "type": "string",
          "enum": [
            "local",
            "kroki",
            "off"
          ],
          "default": "local",
          "scope": "language-overridable",
          "description": "%configuration.vviewer.markdown.diagramMode.description%",
          "title": "%configuration.vviewer.markdown.diagramMode.title%"
        },
        "vviewer.diagrams.allowRemoteServices": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%configuration.vviewer.diagrams.allowRemoteServices.description%",
          "title": "%configuration.vviewer.diagrams.allowRemoteServices.title%"
        },
        "vviewer.markdown.externalImages": {
          "type": "string",
          "enum": [
            "blocked",
            "manual",
            "auto"
          ],
          "default": "blocked",
          "scope": "window",
          "description": "%configuration.vviewer.markdown.externalImages.description%",
          "title": "%configuration.vviewer.markdown.externalImages.title%"
        },
        "vviewer.markdown.externalImageAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "%configuration.vviewer.markdown.externalImageAllowlist.description%",
          "title": "%configuration.vviewer.markdown.externalImageAllowlist.title%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "ovsx": "^1.4.0"
  },
  "dependencies": {
    "@bhxch/vviewer-core": "workspace:*",
    "@bhxch/vviewer-detect": "workspace:*",
    "@bhxch/vviewer-highlight": "workspace:*",
    "@bhxch/vviewer-lightbox": "workspace:*",
    "@bhxch/vviewer-markdown": "workspace:*",
    "@bhxch/vviewer-render-binary": "workspace:*",
    "@bhxch/vviewer-render-diagram": "workspace:*",
    "@bhxch/vviewer-render-doc": "workspace:*",
    "@bhxch/vviewer-render-media": "workspace:*",
    "@bhxch/vviewer-render-text": "workspace:*",
    "@bhxch/vviewer-sanitize": "workspace:*",
    "katex": "^0.19.0"
  }
}
