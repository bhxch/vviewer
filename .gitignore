# 临时与工具
.temp/
.zcode/

# Node / 前端
node_modules/
apps/web/.svelte-kit/
apps/web/build/
apps/web/dist/
apps/web/test-results/
apps/web/playwright-report/
packages/*/dist/
*.tsbuildinfo

# Rust
server/target/
# 桌面壳（Tauri）：cargo 目标目录、sidecar 落位产物与构建期生成的 ACL schema
# （tauri-build 每次 build 重新生成 gen/schemas，均不入库）
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/vviewer-server-*
apps/desktop/src-tauri/gen/

# grammar wasm 资产（构建产物，不入库）：源清单 languages.toml、aliases.json、build-list.json
# 与构建器入库；产物由 `pnpm gen:grammars` 生成（tree-sitter-cli 自建，vendored 例外见
# tools/grammar-builder/fixtures/）。tools/grammar-builder/grammars 与 out 为源缓存/失败清单。
tools/grammar-builder/grammars/
tools/grammar-builder/out/
*.wasm
!tools/grammar-builder/fixtures/*.wasm
# static/grammars 整目录（*.wasm 与生成的 manifest.json，构建产物）
apps/web/static/grammars/
# tree-sitter 查询静态资产（构建期由 vite 插件从 packages/highlight/assets/queries 拷贝，不入库）
apps/web/static/queries/
# libarchive.js worker bundle 与 wasm（构建期由 vite 插件从 node_modules 拷贝，不入库）
apps/web/static/libarchive/
# BUG-60：vv-* 运行时缓存跨版本清理脚本（构建期由 vite 插件生成、烘焙 BUILD_REVISION，不入库）
apps/web/static/vv-sw-cleanup.js
# web-tree-sitter runtime wasm（构建期由 gen:grammars 从 node_modules 拷贝，不入库；版本随 packages/highlight 的 lockfile 锁定）
apps/web/static/tree-sitter.wasm
# svgbob wasm 引擎产物（构建期由 gen:svgbob-wasm 从 @vviewer/render-diagram 包内
# tools/svgbob-wasm crate 生成，不入库；svgbob_wasm.d.ts 手写入库仅类型声明）。
# *.wasm 已被全局规则覆盖，.js 显式排除防 glue 混入
packages/render-diagram/src/markdown/svgbob-wasm-gen/*.js
packages/render-diagram/src/markdown/svgbob-wasm-gen/*.wasm

# 系统
.DS_Store
# E2E 大文件兜底：m6.spec 已把 BIG_FILE 写到 os.tmpdir() fixture（不碰 tracked 树），
# 此条防旧运行残留/回归时把 ≈1.5MB 生成文件带进 tracked 树
samples/m6/e2e-big.js
# E2E 多源语料（SOURCES 表各上游仓固定 commit 的真实文件）：经 tools/fetch-e2e-corpus.mjs
# 下载到 apps/web/e2e/fixtures/corpus/<source-id>/ 供 markdown/代码高亮渲染测试使用；多源
# 语料不入库避免许可证问题，下载脚本（本地与 CI 同步执行）即初始化测试环境的一步
apps/web/e2e/fixtures/corpus/
# PWA 图标（构建期由 tools/gen-icons.mjs 生成，不入库）
apps/web/static/icons/

# Workers 本地 dev 的临时 env（凭据不入库；部署面走 Wrangler Secrets）
server/worker/.dev.vars
# worker-build 产物（build/；部署期生成）
server/worker/build/

# wrangler 本地 dev 状态（miniflare sqlite/tmp bundle，不入库）
server/worker/.wrangler/
