# 临时与工具
.temp/
.zcode/

# Node / 前端
node_modules/
apps/web/.svelte-kit/
apps/web/build/
apps/web/dist/
apps/web/test-results/
apps/web/playwright-report/
packages/*/dist/
*.tsbuildinfo

# Rust
server/target/

# grammar 构建产物（源清单 languages.toml 入库，下载的 grammar 源码与编译产物不入库）
tools/grammar-builder/grammars/
tools/grammar-builder/out/
*.wasm
!tools/grammar-builder/fixtures/*.wasm
# M2 决定：static/grammars 的 wasm 与 manifest 入库（纯前端版开箱可用；单文件 ≤8MB、总量 ≤80MB）
!apps/web/static/grammars/*.wasm
# web-tree-sitter runtime（web-tree-sitter@0.25 的 tree-sitter.wasm，Parser.init locateFile 指向 static）
!apps/web/static/tree-sitter.wasm

# 系统
.DS_Store
