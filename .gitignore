# 临时与工具
.temp/
.zcode/

# Node / 前端
node_modules/
apps/web/.svelte-kit/
apps/web/build/
apps/web/dist/
apps/web/test-results/
apps/web/playwright-report/
packages/*/dist/
*.tsbuildinfo

# Rust
server/target/

# grammar wasm 资产（构建产物，不入库）：源清单 languages.toml、aliases.json、build-list.json
# 与构建器入库；产物由 `pnpm gen:grammars` 生成（tree-sitter-cli 自建，vendored 例外见
# tools/grammar-builder/fixtures/）。tools/grammar-builder/grammars 与 out 为源缓存/失败清单。
tools/grammar-builder/grammars/
tools/grammar-builder/out/
*.wasm
!tools/grammar-builder/fixtures/*.wasm
# static/grammars 整目录（*.wasm 与生成的 manifest.json，构建产物）
apps/web/static/grammars/
# tree-sitter 查询静态资产（构建期由 vite 插件从 packages/highlight/assets/queries 拷贝，不入库）
apps/web/static/queries/
# libarchive.js worker bundle 与 wasm（构建期由 vite 插件从 node_modules 拷贝，不入库）
apps/web/static/libarchive/
# web-tree-sitter runtime wasm（构建期由 gen:grammars 从 node_modules 拷贝，不入库；版本随 packages/highlight 的 lockfile 锁定）
apps/web/static/tree-sitter.wasm

# 系统
.DS_Store
# E2E 大文件兜底：m6.spec 已把 BIG_FILE 写到 os.tmpdir() fixture（不碰 tracked 树），
# 此条防旧运行残留/回归时把 ≈1.5MB 生成文件带进 tracked 树
samples/m6/e2e-big.js
# PWA 图标（构建期由 tools/gen-icons.mjs 生成，不入库）
apps/web/static/icons/
